# ── Ollama (local AI) ─────────────────────────────────────────────────────────
# URL of your local Ollama instance. Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (must be pulled first: ollama pull llama3)
OLLAMA_MODEL=llama3

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from your Stripe dashboard (Products → Prices)
STRIPE_PERSONAL_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Public URL used for Stripe success/cancel redirects
PUBLIC_URL=https://your-domain.com
